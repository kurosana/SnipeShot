scripts/write_bats.py
scripts/build_explain.py

# 検証・作業用
Trash/
_verify*.py
_out.txt

# 秘密情報
.env
.env.*
*.pem
*.key

# OS
.DS_Store
Thumbs.db
Desktop.ini

# エディタ
.vscode/
.idea/
*.swp
*~

# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc

# 一時ファイル
*.tmp
*.bak
